{
  "name": "team-task-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r --filter './apps/api' run test",
    "typecheck": "pnpm --filter './apps/web' run typecheck",
    "lint": "eslint 'apps/**/*.{ts,tsx}' --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "typescript": "^6.0.3"
  }
}
